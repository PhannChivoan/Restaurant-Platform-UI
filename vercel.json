{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/FoodOrder.mobileconfig",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" },
        { "key": "Content-Disposition", "value": "attachment; filename=FoodOrder.mobileconfig" }
      ]
    }
  ]
}